{
  "name": "livechat-ai-railway",
  "version": "1.31.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-all.mjs",
    "verify": "npm run check && npm test && npm run audit",
    "audit": "node scripts/release-audit.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "browser:qa": "python3 scripts/browser-qa.py",
    "verify:full": "npm run check && npm test && npm run audit && npm run browser:qa"
  },
  "dependencies": {
    "express": "5.1.0",
    "pg": "8.16.3",
    "qrcode": "1.5.4"
  }
}
